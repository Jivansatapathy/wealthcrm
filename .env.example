# Template for Environment Configuration
VITE_FINNHUB_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=
VITE_NEWS_API_KEY=
VITE_FMP_API_KEY=

VITE_APOLLO_API_KEY=
VITE_ZOOMINFO_API_KEY=
VITE_PITCHBOOK_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=
MONGODB_URI=

VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=

PORT=3000
VITE_APP_ENV=development

# --- Lead acquisition pipeline (server-side only: never prefix with VITE_) ---
# Access tokens, role:token pairs (each token >=16 chars). Outside production, dev tokens are generated if unset.
ACQ_TOKENS=
# Legal name of the business receiving enquiries. The public enquiry form stays disabled until this is set.
ACQ_BUSINESS_NAME=
ACQ_PRIVACY_URL=
# Public base URL (used in confirmation-email links) and optional webhook that sends the confirmation email
ACQ_PUBLIC_URL=
ACQ_MAIL_WEBHOOK=
# Optional Cloudflare Turnstile keys for the enquiry form
ACQ_TURNSTILE_SECRET=
ACQ_TURNSTILE_SITE_KEY=
# Minimum relevance score for an inferred lead to be kept (default 25)
ACQ_MIN_SCORE=25
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
ACQ_TRUST_PROXY=
# Where the JSON store lives (contains personal data; keep out of git)
ACQ_DATA_DIR=
# Contact string sent in the User-Agent to SEC EDGAR (required by SEC fair-access policy)
SCRAPER_CONTACT=
