# Template for Environment Configuration
VITE_FINNHUB_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=
VITE_NEWS_API_KEY=
VITE_FMP_API_KEY=

VITE_APOLLO_API_KEY=
VITE_ZOOMINFO_API_KEY=
VITE_PITCHBOOK_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Database URLs
DATABASE_URL=postgresql://username:password@host:port/database
VITE_DATABASE_URL=postgresql://username:password@host:port/database
MONGODB_URI=

# AI Chatbot & Assistant Models
OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_ANTHROPIC_API_KEY=

# Lead Intelligence & Enrichment
APOLLO_API_KEY=your_apollo_api_key_here
VITE_APOLLO_API_KEY=your_apollo_api_key_here

PORT=3000
VITE_APP_ENV=development

# --- Lead acquisition pipeline (server-side only: never prefix with VITE_) ---
# Access tokens, role:token pairs (each token >=16 chars). Outside production, dev tokens are generated if unset.
ACQ_TOKENS=
# Legal name of the business receiving enquiries. The public enquiry form stays disabled until this is set.
ACQ_BUSINESS_NAME=
ACQ_PRIVACY_URL=
# Public base URL (used in confirmation-email links) and optional webhook that sends the confirmation email
ACQ_PUBLIC_URL=
ACQ_MAIL_WEBHOOK=
# Optional Cloudflare Turnstile keys for the enquiry form
ACQ_TURNSTILE_SECRET=
ACQ_TURNSTILE_SITE_KEY=
# Minimum relevance score for an inferred lead to be kept (default 25)
ACQ_MIN_SCORE=25
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
ACQ_TRUST_PROXY=
# Where the JSON store lives (contains personal data; keep out of git)
ACQ_DATA_DIR=
# Contact string sent in the User-Agent to SEC EDGAR (required by SEC fair-access policy)
SCRAPER_CONTACT=

# --- Google market-signal connectors (server-side only: never prefix with VITE_) ---
# Service account JSON key file; add its email as a user on the Search Console property and as Viewer on the GA4 property
GOOGLE_SERVICE_ACCOUNT_FILE=
GSC_SITE_URL=
GA4_PROPERTY_ID=
# Google Ads Keyword Planner (needs an approved developer token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v20

# --- Eventbrite (own events, registration counts only) ---
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=

# Midu funding API (free key from midu.si; internal research use only)
MIDU_API_KEY=

# --- Authentication & Authorization (keep secret) ---
JWT_SECRET=your_jwt_secret_min_32_chars_here
DEMO_USER_PASSWORD=your_demo_seed_password_here
TEST_USER_PASSWORD=your_test_password_here

